{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": { "framer": ["./types/framer/index.d.ts"] }
  },
  "include": ["CraziologistChat-promo.tsx", "types/**/*.d.ts"]
}
